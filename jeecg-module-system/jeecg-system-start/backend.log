original SQL: SELECT
            icn.id,
            icn.create_by,
            icn.create_time,
            icn.update_by,
            icn.update_time,
            icn.cm_node_id,
            icn.sns,
            icn.rpc,
            icn.rpc_name,
            icn.originator,
            icn.originator_name,
            icn.unique_id,
            icn.variant_code,
            icn.issue_no,
            icn.security_classification,
            icn.security,
            icn.icn_type,
            icn.ispublished,
            icn.isdeleted,
            icn.version,
            icn.org_identity,
            icn.icn,
            att1.id as "ietmAttachment.id",
            att1.file_name as "ietmAttachment.fileName",
            att1.file_size as "ietmAttachment.fileSize",
            att1.file_key as "ietmAttachment.fileKey",
            att2.id as "relatedIetmAttachment.id",
            att2.file_name as "relatedIetmAttachment.fileName",
            att2.file_key as "relatedIetmAttachment.fileKey"
        FROM ietm_icn_manage icn
        LEFT JOIN ietm_attachment att1 ON icn.id = att1.pid AND att1.file_type = '实体文件'
        LEFT JOIN ietm_attachment att2 ON icn.id = att2.pid AND att2.file_type = '相关文件'
        WHERE icn.cm_node_id IN (
            SELECT id
            FROM ietm_project_configuration_management
            START WITH id = ?
            CONNECT BY PRIOR id = pid
        )
        AND icn.isdeleted = '0'
        ORDER BY icn.create_time DESC
original SQL: SELECT
            t1.id, t1.project_id, t1.project_name, t1.sns, t1.info_code, t1.info_code_variant,
            t1.ietm_location_code, t1.originator, t1.originator_name, t1.issue_no, t1.in_work,
            t1.version_type, t1.issue_type, t1.tech_name, t1.info_name, t1.cm_node_id, t1.cm_node_name, t1.cm_node_path,
            t1.is_latest, t1.status, t1.checkout_user, t1.checkout_time, t1.checkout_dm_id,
            t1.workflow_instance_id, t1.workflow_status, t1.dmc_code, t1.create_time, t1.update_time,
            -- 列表/详情展示所需字段（DM类型/密级/签发日期/语言/国家/责任单位）
            t1.dm_type, t1.security, t1.issue_date, t1.language_iso_code, t1.country_iso_code,
            t1.rpc, t1.rpc_name,
            -- 从流程视图获取动态字段
            v.activityalias_ AS activityalias_,  -- 流程当前步骤（实时计算）
            v.currenthandler_ AS currenthandler_  -- 当前待办人（实时）
        FROM ietm_data_module t1
        LEFT JOIN (
            -- 🔧 修复BUG-2026-08-23-001：只JOIN每个formid的最新流程实例
            -- 原因：同一个DM可能有多个流程实例（旧的已结束+新的进行中），导致LEFT JOIN产生重复行
            -- 方案：按formid_分组，取createtime_最大的那条（最新流程实例）
            SELECT
                v1.formid_,
                v1.activityalias_,
                v1.currenthandler_
            FROM v_wf_instance v1
            INNER JOIN (
                SELECT formid_, MAX(createtime_) AS max_createtime
                FROM v_wf_instance
                GROUP BY formid_
