            icn.sns,
            icn.rpc,
            icn.rpc_name,
            icn.originator,
            icn.originator_name,
            icn.unique_id,
            icn.variant_code,
            icn.issue_no,
            icn.security_classification,
            icn.security,
            icn.icn_type,
            icn.ispublished,
            icn.isdeleted,
            icn.version,
            icn.org_identity,
            icn.icn,
            att1.id as "ietmAttachment.id",
            att1.file_name as "ietmAttachment.fileName",
            att1.file_size as "ietmAttachment.fileSize",
            att1.file_key as "ietmAttachment.fileKey",
            att2.id as "relatedIetmAttachment.id",
            att2.file_name as "relatedIetmAttachment.fileName",
            att2.file_key as "relatedIetmAttachment.fileKey"
        FROM ietm_icn_manage icn
        LEFT JOIN ietm_attachment att1 ON icn.id = att1.pid AND att1.file_type = '实体文件'
        LEFT JOIN ietm_attachment att2 ON icn.id = att2.pid AND att2.file_type = '相关文件'
        WHERE icn.cm_node_id IN (
            SELECT id
            FROM ietm_project_configuration_management
            START WITH id = ?
            CONNECT BY PRIOR id = pid
        )
        AND icn.isdeleted = '0'
        ORDER BY icn.create_time DESC
