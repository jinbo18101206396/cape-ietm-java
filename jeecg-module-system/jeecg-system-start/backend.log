original SQL: SELECT
            t1.id, t1.project_id, t1.project_name, t1.sns, t1.info_code, t1.info_code_variant,
            t1.ietm_location_code, t1.originator, t1.originator_name, t1.issue_no, t1.in_work,
            t1.version_type, t1.issue_type, t1.tech_name, t1.info_name, t1.cm_node_id, t1.cm_node_name, t1.cm_node_path,
            t1.is_latest, t1.status, t1.checkout_user, t1.checkout_time, t1.checkout_dm_id,
            t1.workflow_instance_id, t1.workflow_status, t1.dmc_code, t1.create_time, t1.update_time,
            -- 列表/详情展示所需字段（DM类型/密级/签发日期/语言/国家/责任单位）
            t1.dm_type, t1.security, t1.issue_date, t1.language_iso_code, t1.country_iso_code,
            t1.rpc, t1.rpc_name,
            -- 从流程视图获取动态字段
            v.activityalias_ AS activityalias_,  -- 流程当前步骤（实时计算）
            v.currenthandler_ AS currenthandler_  -- 当前待办人（实时）
        FROM ietm_data_module t1
        LEFT JOIN (
            -- 🔧 修复BUG-2026-08-23-001：只JOIN每个formid的最新流程实例
            -- 原因：同一个DM可能有多个流程实例（旧的已结束+新的进行中），导致LEFT JOIN产生重复行
            -- 方案：按formid_分组，取createtime_最大的那条（最新流程实例）
            SELECT
                v1.formid_,
                v1.activityalias_,
                v1.currenthandler_
            FROM v_wf_instance v1
            INNER JOIN (
                SELECT formid_, MAX(createtime_) AS max_createtime
                FROM v_wf_instance
                GROUP BY formid_
            ) v2 ON v1.formid_ = v2.formid_ AND v1.createtime_ = v2.max_createtime
        ) v ON t1.id = v.formid_
        WHERE t1.status = '1'
          AND t1.is_latest = '1'
           
              AND t1.project_id = ?
           
           
        ORDER BY t1.create_time DESC
