                THEN '1'
                ELSE '0'
            END as needDimension
        FROM ietm_icn_manage icn
        LEFT JOIN ietm_attachment att ON icn.id = att.pid AND att.file_type = '实体文件'
        WHERE icn.cm_node_id IN (
