package org.jeecg.modules.ietm.workflow.test;

import com.baomidou.mybatisplus.core.conditions.query.LambdaQueryWrapper;
import lombok.extern.slf4j.Slf4j;
import org.jeecg.modules.ietm.ietmdatamodulemanagement.entity.IetmDataModule;
import org.jeecg.modules.ietm.ietmdatamodulemanagement.mapper.IetmDataModuleMapper;
import org.jeecg.modules.ietm.workflow.entity.WfInstance;
import org.jeecg.modules.ietm.workflow.entity.WfInstanceDtl;
import org.jeecg.modules.ietm.workflow.mapper.WfInstanceDtlMapper;
import org.jeecg.modules.ietm.workflow.mapper.WfInstanceMapper;
import org.junit.jupiter.api.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.test.context.ActiveProfiles;

import java.util.List;
import java.util.Map;

import static org.junit.jupiter.api.Assertions.*;

/**
 * v_wf_instance 视图集成测试
 *
 * 目的：系统、全面、深度排查 v_wf_instance 视图失效问题
 *
 * 排查维度：
 * 1. 视图定义完整性：视图是否存在、是否有效、字段映射是否正确
 * 2. 字段命名一致性：instanceid vs instid 在各层的使用情况
 * 3. 数据关联完整性：视图数据与基础表的关联是否正确
 * 4. 业务功能影响：DM管理页面等依赖视图的功能是否正常
 * 5. 边界场景覆盖：各种流程状态下视图数据的正确性
 *
 * @author IETM Team
 * @date 2026-08-20
 */
@Slf4j
@SpringBootTest
@ActiveProfiles("test")
@TestMethodOrder(MethodOrderer.OrderAnnotation.class)
@DisplayName("v_wf_instance视图集成测试 - 深度排查视图失效问题")
public class VwfInstanceViewIntegrationTest {

    @Autowired
    private JdbcTemplate jdbcTemplate;

    @Autowired
    private WfInstanceMapper wfInstanceMapper;

    @Autowired
    private WfInstanceDtlMapper wfInstanceDtlMapper;

    @Autowired
    private IetmDataModuleMapper ietmDataModuleMapper;

    // ========================================================================
    // 第一部分：视图定义完整性检查
    // ========================================================================

    @Test
    @Order(1)
    @DisplayName("检查1.1：v_wf_instance视图是否存在")
    public void testViewExists() {
        String sql = "SELECT COUNT(*) FROM USER_VIEWS WHERE VIEW_NAME = 'v_wf_instance'";
        Integer count = jdbcTemplate.queryForObject(sql, Integer.class);

        assertNotNull(count, "视图查询结果不应为null");
        assertEquals(1, count.intValue(),
            "【关键问题】v_wf_instance 视图不存在！需要创建视图。");
    }

    @Test
    @Order(2)
    @DisplayName("检查1.2：v_wf_instance视图是否有效（非INVALID状态）")
    public void testViewIsValid() {
        String sql = "SELECT STATUS FROM USER_VIEWS WHERE VIEW_NAME = 'v_wf_instance'";

        try {
            String status = jdbcTemplate.queryForObject(sql, String.class);
            assertNotNull(status, "视图状态不应为null");
            assertEquals("VALID", status,
                "【核心问题】v_wf_instance 视图状态为 " + status + "，应该是VALID！" +
                "\n原因：视图定义中使用了已修改的字段名（instid改为instanceid）");
        } catch (Exception e) {
            fail("查询视图状态失败：" + e.getMessage());
        }
    }

    @Test
    @Order(3)
    @DisplayName("检查1.3：直接查询v_wf_instance视图是否报错")
    public void testViewQueryable() {
        String sql = "SELECT COUNT(*) FROM v_wf_instance";

        try {
            Integer count = jdbcTemplate.queryForObject(sql, Integer.class);
            assertNotNull(count, "视图查询结果不应为null");
            log.info("v_wf_instance 视图包含 {} 条记录", count);
        } catch (Exception e) {
            fail("【核心错误】查询 v_wf_instance 视图失败：" + e.getMessage() +
                "\n这是用户报告的错误：'对象[v_wf_instance]处于无效状态'");
        }
    }

    @Test
    @Order(4)
    @DisplayName("检查1.4：v_wf_instance视图字段定义")
    public void testViewColumns() {
        String sql = "SELECT COLUMN_NAME FROM USER_TAB_COLUMNS " +
                    "WHERE TABLE_NAME = 'v_wf_instance' ORDER BY COLUMN_ID";

        try {
            List<String> columns = jdbcTemplate.queryForList(sql, String.class);

            assertTrue(columns.size() > 0, "视图应该有字段");

            // 关键字段检查
            assertTrue(columns.contains("id_") || columns.contains("ID_"),
                "视图应包含 id_ 字段");
            assertTrue(columns.contains("formid_") || columns.contains("FORMID_"),
                "视图应包含 formid_ 字段（关联业务表）");
            assertTrue(columns.contains("status_") || columns.contains("STATUS_"),
                "视图应包含 status_ 字段（流程状态）");
            assertTrue(columns.contains("activityalias_") || columns.contains("ACTIVITYALIAS_"),
                "视图应包含 activityalias_ 字段（当前步骤）");
            assertTrue(columns.contains("currenthandler_") || columns.contains("CURRENTHANDLER_"),
                "视图应包含 currenthandler_ 字段（当前待办人）");

            log.info("v_wf_instance 视图字段列表: {}", columns);
        } catch (Exception e) {
            fail("查询视图字段定义失败：" + e.getMessage());
        }
    }

    // ========================================================================
    // 第二部分：字段命名一致性审计
    // ========================================================================

    @Test
    @Order(10)
    @DisplayName("检查2.1：wf_instance_dtl表字段名 - 应为instanceid_而非instid_")
    public void testTableColumnNaming() {
        String sql = "SELECT COLUMN_NAME FROM USER_TAB_COLUMNS " +
                    "WHERE TABLE_NAME = 'wf_instance_dtl' " +
                    "AND COLUMN_NAME LIKE '%INST%' " +
                    "ORDER BY COLUMN_NAME";

        List<String> columns = jdbcTemplate.queryForList(sql, String.class);

        log.info("wf_instance_dtl 表中包含INST的字段: {}", columns);

        // 应该包含 instanceid_，不应包含 instid_
        boolean hasInstanceid = columns.stream()
            .anyMatch(c -> c.equalsIgnoreCase("instanceid_"));
        boolean hasInstid = columns.stream()
            .anyMatch(c -> c.equalsIgnoreCase("instid_"));

        assertTrue(hasInstanceid,
            "【字段命名】wf_instance_dtl表应该有instanceid_字段");
        assertFalse(hasInstid,
            "【字段命名】wf_instance_dtl表不应该有instid_字段（已重命名为instanceid_）");
    }

    @Test
    @Order(11)
    @DisplayName("检查2.2：实体类字段映射 - WfInstanceDtl.instanceid")
    public void testEntityFieldMapping() {
        // 创建查询，使用实体类字段
        LambdaQueryWrapper<WfInstanceDtl> wrapper = new LambdaQueryWrapper<>();
        wrapper.last("LIMIT 1");

        try {
            WfInstanceDtl dtl = wfInstanceDtlMapper.selectOne(wrapper);
            if (dtl != null) {
                String instanceid = dtl.getInstanceid();
                assertNotNull(instanceid,
                    "【实体映射】WfInstanceDtl.getInstanceid() 应该能正常获取值");
                log.info("实体类字段映射正常，instanceid: {}", instanceid);
            }
        } catch (Exception e) {
            fail("【实体映射错误】实体类字段映射失败：" + e.getMessage() +
                "\n可能原因：@TableField注解配置错误或getter/setter方法不匹配");
        }
    }

    @Test
    @Order(12)
    @DisplayName("检查2.3：XML Mapper中的字段引用")
    public void testXmlMapperFieldReference() {
        // 通过实际执行Mapper方法来验证XML中的字段引用是否正确
        List<WfInstance> instances = wfInstanceMapper.selectList(
            new LambdaQueryWrapper<WfInstance>()
                .eq(WfInstance::getStatus, "1")
                .last("LIMIT 5")
        );

        for (WfInstance instance : instances) {
            try {
                // 这个方法内部使用了 instanceid_ 字段
                List<WfInstanceDtl> dtls = wfInstanceDtlMapper.selectByInstId(instance.getId());

                log.info("实例 {} 的节点数量: {}", instance.getId(), dtls.size());

                for (WfInstanceDtl dtl : dtls) {
                    assertEquals(instance.getId(), dtl.getInstanceid(),
                        "【字段关联】节点的instanceid应等于实例ID");
                }
            } catch (Exception e) {
                fail("【XML Mapper错误】selectByInstId方法执行失败：" + e.getMessage() +
                    "\n检查 WfInstanceDtlMapper.xml 中是否正确使用 instanceid_ 字段");
            }
        }
    }

    // ========================================================================
    // 第三部分：数据关联完整性验证
    // ========================================================================

    @Test
    @Order(20)
    @DisplayName("检查3.1：wf_instance与wf_instance_dtl关联完整性")
    public void testInstanceDtlRelationship() {
        // 查询流转中的实例
        List<WfInstance> instances = wfInstanceMapper.selectList(
            new LambdaQueryWrapper<WfInstance>()
                .eq(WfInstance::getStatus, "1")
                .last("LIMIT 10")
        );

        assertTrue(instances.size() > 0, "应该存在流转中的实例用于测试");

        for (WfInstance instance : instances) {
            // 查询该实例的节点
            List<WfInstanceDtl> dtls = wfInstanceDtlMapper.selectList(
                new LambdaQueryWrapper<WfInstanceDtl>()
                    .eq(WfInstanceDtl::getInstanceid, instance.getId())
            );

            assertTrue(dtls.size() > 0,
                "流转中的实例 " + instance.getId() + " 应该有节点记录");

            // 验证所有节点的instanceid都指向正确的实例
            for (WfInstanceDtl dtl : dtls) {
                assertEquals(instance.getId(), dtl.getInstanceid(),
                    "节点的instanceid应该等于实例ID");
            }

            log.info("实例 {} 关联节点数: {}", instance.getId(), dtls.size());
        }
    }

    @Test
    @Order(21)
    @DisplayName("检查3.2：视图数据与基础表数据一致性")
    public void testViewDataConsistency() {
        // 从视图查询
        String viewSql = "SELECT id_, formid_, status_, activityalias_ FROM v_wf_instance";
        List<Map<String, Object>> viewData = jdbcTemplate.queryForList(viewSql);

        assertTrue(viewData.size() > 0, "视图应该返回数据");

        // 对比基础表数据
        for (Map<String, Object> row : viewData) {
            String instanceId = (String) row.get("id_");
            WfInstance instance = wfInstanceMapper.selectById(instanceId);

            assertNotNull(instance, "视图中的实例ID应该在基础表中存在");
            assertEquals(row.get("formid_"), instance.getFormid(),
                "视图的formid应与基础表一致");
            assertEquals(row.get("status_"), instance.getStatus(),
                "视图的status应与基础表一致");
        }

        log.info("视图数据与基础表一致性检查通过，共验证 {} 条记录", viewData.size());
    }

    // ========================================================================
    // 第四部分：业务功能影响范围测试
    // ========================================================================

    @Test
    @Order(30)
    @DisplayName("检查4.1：DM管理页面查询（模拟用户报错场景）")
    public void testDmListPageQuery() {
        // 模拟DM管理页面的查询逻辑
        // 根据 IetmDataModuleMapper.xml 中的 queryListWithFlow 方法

        String sql = "SELECT " +
                    "  t1.id, t1.dm_code, t1.tech_name, t1.workflow_instance_id, " +
                    "  v.activityalias_ AS workflow_step, " +
                    "  v.currenthandler_ AS workflow_handler " +
                    "FROM ietm_data_module t1 " +
                    "LEFT JOIN v_wf_instance v ON t1.id = v.formid_ " +
                    "WHERE t1.status = '1' AND t1.is_latest = '1' " +
                    "FETCH FIRST 5 ROWS ONLY";

        try {
            List<Map<String, Object>> results = jdbcTemplate.queryForList(sql);

            log.info("DM管理页面查询成功，返回 {} 条记录", results.size());

            for (Map<String, Object> row : results) {
                log.info("DM: {} - 流程步骤: {} - 待办人: {}",
                    row.get("dm_code"),
                    row.get("workflow_step"),
                    row.get("workflow_handler"));
            }

        } catch (Exception e) {
            fail("【用户报错场景重现】DM管理页面查询失败：" + e.getMessage() +
                "\n这就是用户看到的错误：'执行数据库异常: 第1 行附近出现错误: 对象[v_wf_instance]处于无效状态'");
        }
    }

    @Test
    @Order(31)
    @DisplayName("检查4.2：IetmDataModuleMapper.queryListWithFlow方法")
    public void testQueryListWithFlowMethod() {
        try {
            // 直接调用Mapper方法
            List<IetmDataModule> modules = ietmDataModuleMapper.selectList(
                new LambdaQueryWrapper<IetmDataModule>()
                    .eq(IetmDataModule::getStatus, "1")
                    .eq(IetmDataModule::getIsLatest, "1")
                    .last("LIMIT 5")
            );

            assertTrue(modules.size() >= 0, "查询应该成功执行");

            for (IetmDataModule module : modules) {
                log.info("DM: {} - 流程实例ID: {} - 流程状态: {}",
                    module.getDmCode(),
                    module.getWorkflowInstanceId(),
                    module.getWorkflowStatus());
            }

        } catch (Exception e) {
            fail("【Mapper方法错误】queryListWithFlow执行失败：" + e.getMessage());
        }
    }

    // ========================================================================
    // 第五部分：边界场景覆盖
    // ========================================================================

    @Test
    @Order(40)
    @DisplayName("检查5.1：未启动流程的DM（workflow_instance_id=NULL）")
    public void testDmWithoutWorkflow() {
        List<IetmDataModule> modules = ietmDataModuleMapper.selectList(
            new LambdaQueryWrapper<IetmDataModule>()
                .isNull(IetmDataModule::getWorkflowInstanceId)
                .eq(IetmDataModule::getStatus, "1")
                .last("LIMIT 5")
        );

        if (modules.size() > 0) {
            log.info("找到 {} 个未启动流程的DM", modules.size());

            // 这些DM在LEFT JOIN v_wf_instance后，流程字段应为NULL
            for (IetmDataModule module : modules) {
                assertNull(module.getWorkflowInstanceId(),
                    "未启动流程的DM的workflow_instance_id应为NULL");
            }
        } else {
            log.warn("数据库中没有未启动流程的DM");
        }
    }

    @Test
    @Order(41)
    @DisplayName("检查5.2：已完成流程的实例（status='3'）")
    public void testCompletedWorkflow() {
        List<WfInstance> instances = wfInstanceMapper.selectList(
            new LambdaQueryWrapper<WfInstance>()
                .eq(WfInstance::getStatus, "3")
                .last("LIMIT 5")
        );

        if (instances.size() > 0) {
            log.info("找到 {} 个已完成的流程实例", instances.size());

            // 已完成的流程不应出现在v_wf_instance视图中（视图仅包含status='1'）
            String sql = "SELECT COUNT(*) FROM v_wf_instance WHERE id_ = ?";

            for (WfInstance instance : instances) {
                Integer count = jdbcTemplate.queryForObject(sql, Integer.class, instance.getId());
                assertEquals(0, count.intValue(),
                    "已完成的流程实例 " + instance.getId() + " 不应出现在v_wf_instance视图中");
            }
        } else {
            log.warn("数据库中没有已完成的流程实例");
        }
    }

    @Test
    @Order(42)
    @DisplayName("检查5.3：被拒绝的流程（status='2'）")
    public void testRejectedWorkflow() {
        List<WfInstance> instances = wfInstanceMapper.selectList(
            new LambdaQueryWrapper<WfInstance>()
                .eq(WfInstance::getStatus, "2")
                .last("LIMIT 5")
        );

        if (instances.size() > 0) {
            log.info("找到 {} 个被拒绝的流程实例", instances.size());

            // 被拒绝的流程不应出现在v_wf_instance视图中
            String sql = "SELECT COUNT(*) FROM v_wf_instance WHERE id_ = ?";

            for (WfInstance instance : instances) {
                Integer count = jdbcTemplate.queryForObject(sql, Integer.class, instance.getId());
                assertEquals(0, count.intValue(),
                    "被拒绝的流程实例 " + instance.getId() + " 不应出现在v_wf_instance视图中");
            }
        } else {
            log.warn("数据库中没有被拒绝的流程实例");
        }
    }

    // ========================================================================
    // 第六部分：修复方案验证
    // ========================================================================

    @Test
    @Order(50)
    @DisplayName("检查6.1：视图定义中的关键字段引用")
    public void testViewDefinitionFields() {
        // 查询视图定义
        String sql = "SELECT TEXT FROM USER_VIEWS WHERE VIEW_NAME = 'v_wf_instance'";

        try {
            String viewDefinition = jdbcTemplate.queryForObject(sql, String.class);
            assertNotNull(viewDefinition, "视图定义不应为null");

            log.info("v_wf_instance 视图定义:\n{}", viewDefinition);

            // 检查是否使用了正确的字段名
            assertTrue(viewDefinition.toLowerCase().contains("instanceid"),
                "【修复验证】视图定义应使用 instanceid 字段，而非 instid");

            assertFalse(viewDefinition.toLowerCase().contains("dtl.instid"),
                "【修复验证】视图定义不应使用 dtl.instid（应改为 dtl.instanceid）");

        } catch (Exception e) {
            log.error("无法查询视图定义：{}", e.getMessage());
        }
    }

    @Test
    @Order(51)
    @DisplayName("检查6.2：修复脚本准备状态")
    public void testFixScriptExists() {
        String scriptPath = "D:\\workspace\\IETM\\cape-ietm-java\\scripts\\fix-v_wf_instance-view.sql";
        java.io.File script = new java.io.File(scriptPath);

        assertTrue(script.exists(),
            "修复脚本已准备就绪：" + scriptPath);

        log.info("✓ 修复脚本已创建，路径: {}", scriptPath);
        log.info("执行修复脚本后，视图将使用正确的字段名 instanceid");
    }
}
