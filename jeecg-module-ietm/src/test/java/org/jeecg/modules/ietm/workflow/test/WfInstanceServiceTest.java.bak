package org.jeecg.modules.ietm.workflow.test;

import com.baomidou.mybatisplus.core.conditions.query.LambdaQueryWrapper;
import org.jeecg.modules.ietm.workflow.entity.WfInstance;
import org.jeecg.modules.ietm.workflow.entity.WfInstanceDtl;
import org.jeecg.modules.ietm.workflow.mapper.WfInstanceDtlMapper;
import org.jeecg.modules.ietm.workflow.mapper.WfInstanceMapper;
import org.jeecg.modules.ietm.workflow.service.IWfInstanceService;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.transaction.annotation.Transactional;

import java.util.List;

import static org.junit.jupiter.api.Assertions.*;

/**
 * 工作流实例服务测试
 *
 * 测试范围：
 * 1. 实例查询功能
 * 2. 详情节点查询
 * 3. 数据完整性验证
 */
@SpringBootTest
@Transactional
@DisplayName("工作流实例服务测试")
public class WfInstanceServiceTest {

    @Autowired
    private IWfInstanceService wfInstanceService;

    @Autowired
    private WfInstanceMapper wfInstanceMapper;

    @Autowired
    private WfInstanceDtlMapper wfInstanceDtlMapper;

    // ==================== 场景1：实例查询 ====================

    @Test
    @DisplayName("场景1.1：按formid查询实例")
    public void testQueryByFormid() {
        WfInstance instance = wfInstanceMapper.selectOne(
            new LambdaQueryWrapper<WfInstance>()
                .isNotNull(WfInstance::getFormid)
                .last("LIMIT 1")
        );

        if (instance == null) {
            System.out.println("跳过测试：无可用数据");
            return;
        }

        String formid = instance.getFormid();
        WfInstance found = wfInstanceMapper.selectOne(
            new LambdaQueryWrapper<WfInstance>()
                .eq(WfInstance::getFormid, formid)
        );

        assertNotNull(found, "应该能通过formid查询到实例");
        assertEquals(formid, found.getFormid(), "formid应该匹配");

        System.out.println("✓ 场景1.1通过：formid查询成功");
    }

    @Test
    @DisplayName("场景1.2：按状态查询实例")
    public void testQueryByStatus() {
        // 测试status='1'（流转中）
        List<WfInstance> runningInstances = wfInstanceMapper.selectList(
            new LambdaQueryWrapper<WfInstance>()
                .eq(WfInstance::getStatus, "1")
                .last("LIMIT 5")
        );

        for (WfInstance instance : runningInstances) {
            assertEquals("1", instance.getStatus(), "状态应该为'1'");
        }

        // 测试status='0'（已结束）
        List<WfInstance> finishedInstances = wfInstanceMapper.selectList(
            new LambdaQueryWrapper<WfInstance>()
                .eq(WfInstance::getStatus, "0")
                .last("LIMIT 5")
        );

        for (WfInstance instance : finishedInstances) {
            assertEquals("0", instance.getStatus(), "状态应该为'0'");
        }

        // 测试status='2'（已撤销）
        List<WfInstance> cancelledInstances = wfInstanceMapper.selectList(
            new LambdaQueryWrapper<WfInstance>()
                .eq(WfInstance::getStatus, "2")
                .last("LIMIT 5")
        );

        for (WfInstance instance : cancelledInstances) {
            assertEquals("2", instance.getStatus(), "状态应该为'2'");
        }

        System.out.println("✓ 场景1.2通过：状态查询成功");
        System.out.println("  - 流转中(1): " + runningInstances.size());
        System.out.println("  - 已结束(0): " + finishedInstances.size());
        System.out.println("  - 已撤销(2): " + cancelledInstances.size());
    }

    @Test
    @DisplayName("场景1.3：按流程定义查询实例")
    public void testQueryByFlowDefine() {
        WfInstance instance = wfInstanceMapper.selectOne(
            new LambdaQueryWrapper<WfInstance>()
                .isNotNull(WfInstance::getFlowdefine)
                .last("LIMIT 1")
        );

        if (instance == null) {
            System.out.println("跳过测试：无可用数据");
            return;
        }

        String flowdefine = instance.getFlowdefine();
        List<WfInstance> instances = wfInstanceMapper.selectList(
            new LambdaQueryWrapper<WfInstance>()
                .eq(WfInstance::getFlowdefine, flowdefine)
                .last("LIMIT 10")
        );

        assertTrue(instances.size() > 0, "应该能找到相同流程定义的实例");
        for (WfInstance inst : instances) {
            assertEquals(flowdefine, inst.getFlowdefine(), "流程定义应该匹配");
        }

        System.out.println("✓ 场景1.3通过：流程定义查询成功，找到" + instances.size() + "个实例");
    }

    // ==================== 场景2：详情节点查询 ====================

    @Test
    @DisplayName("场景2.1：查询实例的所有节点")
    public void testQueryAllNodesOfInstance() {
        WfInstance instance = wfInstanceMapper.selectOne(
            new LambdaQueryWrapper<WfInstance>()
                .last("LIMIT 1")
        );

        if (instance == null) {
            System.out.println("跳过测试：无可用数据");
            return;
        }

        List<WfInstanceDtl> dtls = wfInstanceDtlMapper.selectList(
            new LambdaQueryWrapper<WfInstanceDtl>()
                .eq(WfInstanceDtl::getInstanceid, instance.getId())
        );

        assertTrue(dtls.size() > 0, "实例应该至少有一个节点");

        for (WfInstanceDtl dtl : dtls) {
            assertEquals(instance.getId(), dtl.getInstanceid(),
                "节点的instanceid应该匹配实例ID");
        }

        System.out.println("✓ 场景2.1通过：查询到" + dtls.size() + "个节点");
    }

    @Test
    @DisplayName("场景2.2：查询当前待处理节点")
    public void testQueryCurrentPendingNodes() {
        WfInstance instance = wfInstanceMapper.selectOne(
            new LambdaQueryWrapper<WfInstance>()
                .eq(WfInstance::getStatus, "1") // 流转中
                .last("LIMIT 1")
        );

        if (instance == null) {
            System.out.println("跳过测试：无流转中的实例");
            return;
        }

        List<WfInstanceDtl> pendingNodes = wfInstanceDtlMapper.selectList(
            new LambdaQueryWrapper<WfInstanceDtl>()
                .eq(WfInstanceDtl::getInstanceid, instance.getId())
                .eq(WfInstanceDtl::getIfexec, "Y") // 待处理
        );

        System.out.println("✓ 场景2.2通过：找到" + pendingNodes.size() + "个待处理节点");

        for (WfInstanceDtl node : pendingNodes) {
            assertEquals("Y", node.getIfexec(), "节点应该是待处理状态");
            System.out.println("  - 节点: " + node.getActivityname() +
                             ", 是否可跳转: " + node.getIfjump());
        }
    }

    @Test
    @DisplayName("场景2.3：查询已处理节点")
    public void testQueryProcessedNodes() {
        WfInstance instance = wfInstanceMapper.selectOne(
            new LambdaQueryWrapper<WfInstance>()
                .last("LIMIT 1")
        );

        if (instance == null) {
            System.out.println("跳过测试：无可用数据");
            return;
        }

        List<WfInstanceDtl> processedNodes = wfInstanceDtlMapper.selectList(
            new LambdaQueryWrapper<WfInstanceDtl>()
                .eq(WfInstanceDtl::getInstanceid, instance.getId())
                .eq(WfInstanceDtl::getIfexec, "N") // 已处理
        );

        System.out.println("✓ 场景2.3通过：找到" + processedNodes.size() + "个已处理节点");

        for (WfInstanceDtl node : processedNodes) {
            assertEquals("N", node.getIfexec(), "节点应该是已处理状态");
        }
    }

    @Test
    @DisplayName("场景2.4：查询可跳转节点")
    public void testQueryJumpableNodes() {
        WfInstance instance = wfInstanceMapper.selectOne(
            new LambdaQueryWrapper<WfInstance>()
                .eq(WfInstance::getStatus, "1")
                .last("LIMIT 1")
        );

        if (instance == null) {
            System.out.println("跳过测试：无流转中的实例");
            return;
        }

        List<WfInstanceDtl> jumpableNodes = wfInstanceDtlMapper.selectList(
            new LambdaQueryWrapper<WfInstanceDtl>()
                .eq(WfInstanceDtl::getInstanceid, instance.getId())
                .eq(WfInstanceDtl::getIfjump, "Y")
        );

        System.out.println("✓ 场景2.4通过：找到" + jumpableNodes.size() + "个可跳转节点");

        for (WfInstanceDtl node : jumpableNodes) {
            assertEquals("Y", node.getIfjump(), "节点应该可跳转");
            System.out.println("  - 可跳转节点: " + node.getActivityname());
        }
    }

    @Test
    @DisplayName("场景2.5：查询可追加意见节点")
    public void testQueryOpinionableNodes() {
        WfInstance instance = wfInstanceMapper.selectOne(
            new LambdaQueryWrapper<WfInstance>()
                .last("LIMIT 1")
        );

        if (instance == null) {
            System.out.println("跳过测试：无可用数据");
            return;
        }

        List<WfInstanceDtl> opinionableNodes = wfInstanceDtlMapper.selectList(
            new LambdaQueryWrapper<WfInstanceDtl>()
                .eq(WfInstanceDtl::getInstanceid, instance.getId())
                .eq(WfInstanceDtl::getIfnoopinion, "N") // 可追加意见
        );

        System.out.println("✓ 场景2.5通过：找到" + opinionableNodes.size() + "个可追加意见节点");

        for (WfInstanceDtl node : opinionableNodes) {
            assertEquals("N", node.getIfnoopinion(), "节点应该允许追加意见");
        }
    }

    // ==================== 场景3：数据完整性验证 ====================

    @Test
    @DisplayName("完整性1：所有实例都有有效的流程定义")
    public void testAllInstancesHaveValidFlowDefine() {
        List<WfInstance> instances = wfInstanceMapper.selectList(
            new LambdaQueryWrapper<WfInstance>()
                .last("LIMIT 50")
        );

        for (WfInstance instance : instances) {
            assertNotNull(instance.getFlowdefine(),
                "实例ID " + instance.getId() + " 应该有流程定义");
            assertFalse(instance.getFlowdefine().trim().isEmpty(),
                "实例ID " + instance.getId() + " 的流程定义不应为空");
        }

        System.out.println("✓ 完整性1通过：检查了" + instances.size() + "个实例的流程定义");
    }

    @Test
    @DisplayName("完整性2：所有实例都有有效的状态")
    public void testAllInstancesHaveValidStatus() {
        List<WfInstance> instances = wfInstanceMapper.selectList(
            new LambdaQueryWrapper<WfInstance>()
                .last("LIMIT 50")
        );

        for (WfInstance instance : instances) {
            assertNotNull(instance.getStatus(),
                "实例ID " + instance.getId() + " 应该有状态");
            assertTrue(instance.getStatus().matches("[012]"),
                "实例ID " + instance.getId() + " 的状态应该是0、1或2，实际为: " + instance.getStatus());
        }

        System.out.println("✓ 完整性2通过：检查了" + instances.size() + "个实例的状态");
    }

    @Test
    @DisplayName("完整性3：每个节点都属于一个有效的实例")
    public void testAllNodesHaveValidInstance() {
        List<WfInstanceDtl> dtls = wfInstanceDtlMapper.selectList(
            new LambdaQueryWrapper<WfInstanceDtl>()
                .last("LIMIT 50")
        );

        for (WfInstanceDtl dtl : dtls) {
            assertNotNull(dtl.getInstanceid(),
                "节点ID " + dtl.getId() + " 应该有instanceid");

            WfInstance instance = wfInstanceMapper.selectById(dtl.getInstanceid());
            assertNotNull(instance,
                "节点ID " + dtl.getId() + " 的instanceid应该能找到对应实例");
        }

        System.out.println("✓ 完整性3通过：检查了" + dtls.size() + "个节点的实例关联");
    }

    @Test
    @DisplayName("完整性4：节点序号连续性")
    public void testNodeSeqContinuity() {
        WfInstance instance = wfInstanceMapper.selectOne(
            new LambdaQueryWrapper<WfInstance>()
                .last("LIMIT 1")
        );

        if (instance == null) {
            System.out.println("跳过测试：无可用数据");
            return;
        }

        List<WfInstanceDtl> dtls = wfInstanceDtlMapper.selectList(
            new LambdaQueryWrapper<WfInstanceDtl>()
                .eq(WfInstanceDtl::getInstanceid, instance.getId())
                .orderByAsc(WfInstanceDtl::getNodeseq)
        );

        if (dtls.isEmpty()) {
            System.out.println("跳过测试：实例无节点");
            return;
        }

        // 检查序号是否从1开始递增
        for (int i = 0; i < dtls.size(); i++) {
            WfInstanceDtl dtl = dtls.get(i);
            Integer expectedSeq = i + 1;
            assertEquals(expectedSeq, dtl.getNodeseq(),
                "节点序号应该连续，期望: " + expectedSeq + ", 实际: " + dtl.getNodeseq());
        }

        System.out.println("✓ 完整性4通过：节点序号连续，共" + dtls.size() + "个节点");
    }

    @Test
    @DisplayName("完整性5：流转中实例至少有一个待处理节点")
    public void testRunningInstancesHavePendingNodes() {
        List<WfInstance> runningInstances = wfInstanceMapper.selectList(
            new LambdaQueryWrapper<WfInstance>()
                .eq(WfInstance::getStatus, "1")
                .last("LIMIT 10")
        );

        for (WfInstance instance : runningInstances) {
            long pendingCount = wfInstanceDtlMapper.selectCount(
                new LambdaQueryWrapper<WfInstanceDtl>()
                    .eq(WfInstanceDtl::getInstanceid, instance.getId())
                    .eq(WfInstanceDtl::getIfexec, "Y")
            );

            assertTrue(pendingCount > 0,
                "流转中的实例ID " + instance.getId() + " 应该至少有一个待处理节点");
        }

        System.out.println("✓ 完整性5通过：检查了" + runningInstances.size() + "个流转中实例");
    }

    // ==================== 边界测试 ====================

    @Test
    @DisplayName("边界1：查询不存在的实例")
    public void testQueryNonExistentInstance() {
        WfInstance instance = wfInstanceMapper.selectById("999999999999999999");
        assertNull(instance, "不存在的实例ID应该返回null");

        System.out.println("✓ 边界1通过：正确处理不存在的实例");
    }

    @Test
    @DisplayName("边界2：查询不存在的节点")
    public void testQueryNonExistentNode() {
        WfInstanceDtl dtl = wfInstanceDtlMapper.selectById("999999999999999999");
        assertNull(dtl, "不存在的节点ID应该返回null");

        System.out.println("✓ 边界2通过：正确处理不存在的节点");
    }

    @Test
    @DisplayName("边界3：空formid查询")
    public void testQueryByEmptyFormid() {
        List<WfInstance> instances = wfInstanceMapper.selectList(
            new LambdaQueryWrapper<WfInstance>()
                .eq(WfInstance::getFormid, "")
        );

        System.out.println("✓ 边界3通过：空formid查询返回" + instances.size() + "条记录");
    }

    @Test
    @DisplayName("边界4：null值字段处理")
    public void testNullFieldHandling() {
        List<WfInstance> instances = wfInstanceMapper.selectList(
            new LambdaQueryWrapper<WfInstance>()
                .isNull(WfInstance::getFormid)
                .last("LIMIT 10")
        );

        for (WfInstance instance : instances) {
            assertNull(instance.getFormid(), "formid应该为null");
        }

        System.out.println("✓ 边界4通过：null字段处理正确，找到" + instances.size() + "条记录");
    }

    @Test
    @DisplayName("边界5：大数据量查询性能")
    public void testLargeQueryPerformance() {
        long startTime = System.currentTimeMillis();

        List<WfInstance> instances = wfInstanceMapper.selectList(
            new LambdaQueryWrapper<WfInstance>()
                .last("LIMIT 1000")
        );

        long endTime = System.currentTimeMillis();
        long duration = endTime - startTime;

        System.out.println("✓ 边界5通过：查询1000条记录耗时" + duration + "ms");
        assertTrue(duration < 5000, "查询1000条记录应该在5秒内完成");
    }
}
