package org.jeecg.modules.ietm.workflow.test;

import com.baomidou.mybatisplus.core.conditions.query.LambdaQueryWrapper;
import org.jeecg.common.exception.JeecgBootException;
import org.jeecg.modules.ietm.workflow.entity.WfExecute;
import org.jeecg.modules.ietm.workflow.entity.WfInstance;
import org.jeecg.modules.ietm.workflow.entity.WfInstanceDtl;
import org.jeecg.modules.ietm.workflow.mapper.WfExecuteMapper;
import org.jeecg.modules.ietm.workflow.mapper.WfInstanceDtlMapper;
import org.jeecg.modules.ietm.workflow.mapper.WfInstanceMapper;
import org.jeecg.modules.ietm.workflow.service.IWfExecuteService;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.transaction.annotation.Transactional;

import java.util.List;

import static org.junit.jupiter.api.Assertions.*;

/**
 * 工作流执行服务测试
 *
 * 测试范围：
 * 1. 核心业务逻辑：通过、不同意、跳转、终止、追加意见、拿回
 * 2. 场景测试：正常流程、异常流程、边界情况
 * 3. 数据一致性：状态更新、字段关联
 */
@SpringBootTest
@Transactional
@DisplayName("工作流执行服务综合测试")
public class WfExecuteServiceTest {

    @Autowired
    private IWfExecuteService wfExecuteService;

    @Autowired
    private WfInstanceMapper wfInstanceMapper;

    @Autowired
    private WfInstanceDtlMapper wfInstanceDtlMapper;

    @Autowired
    private WfExecuteMapper wfExecuteMapper;

    private String testInstanceId;
    private String testDtlId;

    @BeforeEach
    public void setup() {
        // 查找一个测试用的流程实例
        WfInstance testInstance = wfInstanceMapper.selectOne(
            new LambdaQueryWrapper<WfInstance>()
                .eq(WfInstance::getStatus, "1")
                .last("LIMIT 1")
        );

        if (testInstance != null) {
            testInstanceId = testInstance.getId();

            WfInstanceDtl testDtl = wfInstanceDtlMapper.selectOne(
                new LambdaQueryWrapper<WfInstanceDtl>()
                    .eq(WfInstanceDtl::getInstanceid, testInstanceId)
                    .eq(WfInstanceDtl::getIfexec, "Y")
                    .last("LIMIT 1")
            );

            if (testDtl != null) {
                testDtlId = testDtl.getId();
            }
        }
    }

    // ==================== 场景1：通过操作 ====================

    @Test
    @DisplayName("场景1.1：正常通过 - 有意见")
    public void testPassWithOpinion() {
        if (testDtlId == null) {
            System.out.println("跳过测试：无可用测试数据");
            return;
        }

        WfExecute execute = new WfExecute();
        execute.setInstdtlid(testDtlId);
        execute.setIfpass("1"); // 通过
        execute.setOpinion("审核通过，同意进入下一环节");

        assertDoesNotThrow(() -> {
            wfExecuteService.saveOrUpdateExecuteOpinion(execute);
        }, "正常通过操作应该成功");

        System.out.println("✓ 场景1.1通过：正常通过操作成功");
    }

    @Test
    @DisplayName("场景1.2：通过 - 无意见")
    public void testPassWithoutOpinion() {
        if (testDtlId == null) {
            System.out.println("跳过测试：无可用测试数据");
            return;
        }

        WfExecute execute = new WfExecute();
        execute.setInstdtlid(testDtlId);
        execute.setIfpass("1"); // 通过
        execute.setOpinion("");

        assertDoesNotThrow(() -> {
            wfExecuteService.saveOrUpdateExecuteOpinion(execute);
        }, "无意见通过操作应该成功");

        System.out.println("✓ 场景1.2通过：无意见通过操作成功");
    }

    @Test
    @DisplayName("场景1.3：通过 - null意见")
    public void testPassWithNullOpinion() {
        if (testDtlId == null) {
            System.out.println("跳过测试：无可用测试数据");
            return;
        }

        WfExecute execute = new WfExecute();
        execute.setInstdtlid(testDtlId);
        execute.setIfpass("1"); // 通过
        execute.setOpinion(null);

        assertDoesNotThrow(() -> {
            wfExecuteService.saveOrUpdateExecuteOpinion(execute);
        }, "null意见通过操作应该成功");

        System.out.println("✓ 场景1.3通过：null意见通过操作成功");
    }

    // ==================== 场景2：不同意操作 ====================

    @Test
    @DisplayName("场景2.1：不同意 - 正常意见（核心需求）")
    public void testRejectWithValidOpinion() {
        if (testDtlId == null) {
            System.out.println("跳过测试：无可用测试数据");
            return;
        }

        WfExecute execute = new WfExecute();
        execute.setInstdtlid(testDtlId);
        execute.setIfpass("2"); // 不同意
        execute.setOpinion("内容不符合规范，需要修改");

        assertDoesNotThrow(() -> {
            wfExecuteService.saveOrUpdateExecuteOpinion(execute);
        }, "正常不同意操作应该成功");

        // 核心验证：检查实例状态是否被设置为'2'
        WfInstanceDtl dtl = wfInstanceDtlMapper.selectById(testDtlId);
        WfInstance instance = wfInstanceMapper.selectById(dtl.getInstanceid());

        assertEquals("2", instance.getStatus(),
            "【核心需求】不同意操作必须将实例状态设置为'2'");

        System.out.println("✓ 场景2.1通过：不同意操作成功，状态='2' ✓✓✓");
    }

    @Test
    @DisplayName("场景2.2：不同意 - 意见包含'同意'关键字（应拒绝）")
    public void testRejectWithAgreeKeyword() {
        if (testDtlId == null) {
            System.out.println("跳过测试：无可用测试数据");
            return;
        }

        WfExecute execute = new WfExecute();
        execute.setInstdtlid(testDtlId);
        execute.setIfpass("2"); // 不同意
        execute.setOpinion("我不同意，但部分内容我同意");

        JeecgBootException exception = assertThrows(JeecgBootException.class, () -> {
            wfExecuteService.saveOrUpdateExecuteOpinion(execute);
        }, "不同意意见包含'同意'应该抛出异常");

        assertTrue(exception.getMessage().contains("不同意意见中不能包含\"同意\"二字"),
            "异常消息应该说明原因");

        System.out.println("✓ 场景2.2通过：正确拒绝了包含'同意'的不同意意见");
    }

    @Test
    @DisplayName("场景2.3：不同意 - 空意见（应拒绝）")
    public void testRejectWithEmptyOpinion() {
        if (testDtlId == null) {
            System.out.println("跳过测试：无可用测试数据");
            return;
        }

        WfExecute execute = new WfExecute();
        execute.setInstdtlid(testDtlId);
        execute.setIfpass("2"); // 不同意
        execute.setOpinion("");

        JeecgBootException exception = assertThrows(JeecgBootException.class, () -> {
            wfExecuteService.saveOrUpdateExecuteOpinion(execute);
        }, "不同意时空意见应该抛出异常");

        assertTrue(exception.getMessage().contains("不同意必填意见"),
            "异常消息应该说明原因");

        System.out.println("✓ 场景2.3通过：正确拒绝了空意见的不同意操作");
    }

    @Test
    @DisplayName("场景2.4：不同意 - null意见（应拒绝）")
    public void testRejectWithNullOpinion() {
        if (testDtlId == null) {
            System.out.println("跳过测试：无可用测试数据");
            return;
        }

        WfExecute execute = new WfExecute();
        execute.setInstdtlid(testDtlId);
        execute.setIfpass("2"); // 不同意
        execute.setOpinion(null);

        JeecgBootException exception = assertThrows(JeecgBootException.class, () -> {
            wfExecuteService.saveOrUpdateExecuteOpinion(execute);
        }, "不同意时null意见应该抛出异常");

        System.out.println("✓ 场景2.4通过：正确拒绝了null意见的不同意操作");
    }

    @Test
    @DisplayName("场景2.5：不同意 - 纯空格意见（应拒绝）")
    public void testRejectWithWhitespaceOpinion() {
        if (testDtlId == null) {
            System.out.println("跳过测试：无可用测试数据");
            return;
        }

        WfExecute execute = new WfExecute();
        execute.setInstdtlid(testDtlId);
        execute.setIfpass("2"); // 不同意
        execute.setOpinion("   ");

        JeecgBootException exception = assertThrows(JeecgBootException.class, () -> {
            wfExecuteService.saveOrUpdateExecuteOpinion(execute);
        }, "不同意时纯空格意见应该抛出异常");

        System.out.println("✓ 场景2.5通过：正确拒绝了纯空格的不同意意见");
    }

    // ==================== 场景3：跳转操作 ====================

    @Test
    @DisplayName("场景3.1：跳转 - 正常跳转")
    public void testJumpToNode() {
        if (testDtlId == null) {
            System.out.println("跳过测试：无可用测试数据");
            return;
        }

        // 查找可跳转的节点
        WfInstanceDtl currentDtl = wfInstanceDtlMapper.selectById(testDtlId);
        List<WfInstanceDtl> availableNodes = wfInstanceDtlMapper.selectList(
            new LambdaQueryWrapper<WfInstanceDtl>()
                .eq(WfInstanceDtl::getInstanceid, currentDtl.getInstanceid())
                .eq(WfInstanceDtl::getIfjump, "Y")
                .ne(WfInstanceDtl::getId, testDtlId)
        );

        if (availableNodes.isEmpty()) {
            System.out.println("跳过测试：无可跳转节点");
            return;
        }

        WfExecute execute = new WfExecute();
        execute.setInstdtlid(testDtlId);
        execute.setIfpass("3"); // 跳转
        execute.setOpinion("跳转到指定节点处理");
        execute.setJumpdtlid(availableNodes.get(0).getId());

        assertDoesNotThrow(() -> {
            wfExecuteService.saveOrUpdateExecuteOpinion(execute);
        }, "正常跳转操作应该成功");

        System.out.println("✓ 场景3.1通过：正常跳转操作成功");
    }

    @Test
    @DisplayName("场景3.2：跳转 - 缺少目标节点ID（应拒绝）")
    public void testJumpWithoutTargetNode() {
        if (testDtlId == null) {
            System.out.println("跳过测试：无可用测试数据");
            return;
        }

        WfExecute execute = new WfExecute();
        execute.setInstdtlid(testDtlId);
        execute.setIfpass("3"); // 跳转
        execute.setOpinion("跳转");
        execute.setJumpdtlid(null);

        assertThrows(Exception.class, () -> {
            wfExecuteService.saveOrUpdateExecuteOpinion(execute);
        }, "跳转时缺少目标节点应该抛出异常");

        System.out.println("✓ 场景3.2通过：正确拒绝了缺少目标节点的跳转");
    }

    // ==================== 场景4：终止操作 ====================

    @Test
    @DisplayName("场景4.1：终止 - 正常终止")
    public void testTerminateWithOpinion() {
        if (testDtlId == null) {
            System.out.println("跳过测试：无可用测试数据");
            return;
        }

        WfExecute execute = new WfExecute();
        execute.setInstdtlid(testDtlId);
        execute.setIfpass("4"); // 终止
        execute.setOpinion("流程需要终止");

        assertDoesNotThrow(() -> {
            wfExecuteService.saveOrUpdateExecuteOpinion(execute);
        }, "正常终止操作应该成功");

        System.out.println("✓ 场景4.1通过：正常终止操作成功");
    }

    @Test
    @DisplayName("场景4.2：终止 - 空意见（应允许）")
    public void testTerminateWithoutOpinion() {
        if (testDtlId == null) {
            System.out.println("跳过测试：无可用测试数据");
            return;
        }

        WfExecute execute = new WfExecute();
        execute.setInstdtlid(testDtlId);
        execute.setIfpass("4"); // 终止
        execute.setOpinion("");

        // 终止操作可能允许空意见，根据业务规则调整
        assertDoesNotThrow(() -> {
            wfExecuteService.saveOrUpdateExecuteOpinion(execute);
        }, "终止操作可能允许空意见");

        System.out.println("✓ 场景4.2通过：终止操作（空意见）");
    }

    // ==================== 场景5：追加意见 ====================

