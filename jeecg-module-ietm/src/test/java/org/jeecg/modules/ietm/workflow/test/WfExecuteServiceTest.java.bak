    // ==================== 场景6：拿回操作 ====================

    @Test
    @DisplayName("场景6.1：拿回 - 检查是否有后续节点")
    public void testTakeBackValidation() {
        if (testInstanceId == null) {
            System.out.println("跳过测试：无可用测试数据");
            return;
        }

        // 查找一个已处理的节点
        WfInstanceDtl processedDtl = wfInstanceDtlMapper.selectOne(
            new LambdaQueryWrapper<WfInstanceDtl>()
                .eq(WfInstanceDtl::getInstanceid, testInstanceId)
                .eq(WfInstanceDtl::getIfexec, "N")
                .last("LIMIT 1")
        );

        if (processedDtl == null) {
            System.out.println("跳过测试：无已处理节点");
            return;
        }

        WfExecute execute = new WfExecute();
        execute.setInstdtlid(processedDtl.getId());
        execute.setIfpass("6"); // 拿回

        // 拿回操作可能需要检查后续节点是否已处理
        System.out.println("✓ 场景6.1：拿回操作验证（需根据实际业务规则调整）");
    }

    // ==================== 边界测试 ====================

    @Test
    @DisplayName("边界1：无效的操作类型")
    public void testInvalidOptype() {
        if (testDtlId == null) {
            System.out.println("跳过测试：无可用测试数据");
            return;
        }

        WfExecute execute = new WfExecute();
        execute.setInstdtlid(testDtlId);
        execute.setIfpass("99"); // 无效操作类型
        execute.setOpinion("测试");

        assertThrows(Exception.class, () -> {
            wfExecuteService.saveOrUpdateExecuteOpinion(execute);
        }, "无效操作类型应该抛出异常");

        System.out.println("✓ 边界1通过：正确拒绝了无效操作类型");
    }

    @Test
    @DisplayName("边界2：空dtlid")
    public void testNullDtlId() {
        WfExecute execute = new WfExecute();
        execute.setInstdtlid(null);
        execute.setIfpass("1");
        execute.setOpinion("测试");

        assertThrows(Exception.class, () -> {
            wfExecuteService.saveOrUpdateExecuteOpinion(execute);
        }, "空dtlid应该抛出异常");

        System.out.println("✓ 边界2通过：正确拒绝了空dtlid");
    }

    @Test
    @DisplayName("边界3：不存在的dtlid")
    public void testNonExistentDtlId() {
        WfExecute execute = new WfExecute();
        execute.setInstdtlid("999999999999999999"); // 不存在的ID
        execute.setIfpass("1");
        execute.setOpinion("测试");

        assertThrows(Exception.class, () -> {
            wfExecuteService.saveOrUpdateExecuteOpinion(execute);
        }, "不存在的dtlid应该抛出异常");

        System.out.println("✓ 边界3通过：正确拒绝了不存在的dtlid");
    }

    @Test
    @DisplayName("边界4：超长意见")
    public void testVeryLongOpinion() {
        if (testDtlId == null) {
            System.out.println("跳过测试：无可用测试数据");
            return;
        }

        // 生成1000字符的意见
        String longOpinion = "审核意见：".repeat(100);

        WfExecute execute = new WfExecute();
        execute.setInstdtlid(testDtlId);
        execute.setIfpass("1");
        execute.setOpinion(longOpinion);

        // 应该能处理长意见或给出合适的错误提示
        try {
            wfExecuteService.saveOrUpdateExecuteOpinion(execute);
            System.out.println("✓ 边界4通过：能够处理超长意见");
        } catch (Exception e) {
            System.out.println("✓ 边界4通过：正确限制了超长意见 - " + e.getMessage());
        }
    }

    @Test
    @DisplayName("边界5：特殊字符意见")
    public void testSpecialCharactersOpinion() {
        if (testDtlId == null) {
            System.out.println("跳过测试：无可用测试数据");
            return;
        }

        String specialOpinion = "意见包含特殊字符：<script>alert('test')</script>、SQL注入'OR'1'='1、换行\n\r等";

        WfExecute execute = new WfExecute();
        execute.setInstdtlid(testDtlId);
        execute.setIfpass("1");
        execute.setOpinion(specialOpinion);

        assertDoesNotThrow(() -> {
            wfExecuteService.saveOrUpdateExecuteOpinion(execute);
        }, "应该能安全处理特殊字符");

        System.out.println("✓ 边界5通过：安全处理特殊字符");
    }

    // ==================== 数据一致性测试 ====================

    @Test
    @DisplayName("一致性1：instanceid字段映射正确性")
    public void testInstanceidFieldMapping() {
        // 查询所有详情记录
        List<WfInstanceDtl> dtls = wfInstanceDtlMapper.selectList(
            new LambdaQueryWrapper<WfInstanceDtl>()
                .last("LIMIT 10")
        );

        for (WfInstanceDtl dtl : dtls) {
            assertNotNull(dtl.getInstanceid(),
                "instanceid字段应该能正确读取");

            // 验证能否通过instanceid查询到对应的实例
            WfInstance instance = wfInstanceMapper.selectById(dtl.getInstanceid());
            if (instance != null) {
                assertEquals(dtl.getInstanceid(), instance.getId(),
                    "instanceid应该正确关联到wf_instance");
            }
        }

        System.out.println("✓ 一致性1通过：instanceid字段映射正确");
    }

    @Test
    @DisplayName("一致性2：执行记录与详情关联")
    public void testExecuteAndDtlAssociation() {
        // 查询有执行记录的详情
        List<WfExecute> executes = wfExecuteMapper.selectList(
            new LambdaQueryWrapper<WfExecute>()
                .isNotNull(WfExecute::getDtlid)
                .last("LIMIT 10")
        );

        for (WfExecute execute : executes) {
            WfInstanceDtl dtl = wfInstanceDtlMapper.selectById(execute.getInstdtlid());
            assertNotNull(dtl,
                "执行记录的dtlid应该能找到对应的详情记录");
        }

        System.out.println("✓ 一致性2通过：执行记录与详情正确关联");
    }

    @Test
    @DisplayName("一致性3：不同意操作后状态检查")
    public void testRejectStatusConsistency() {
        // 查找所有不同意的执行记录
        List<WfExecute> rejectExecutes = wfExecuteMapper.selectList(
            new LambdaQueryWrapper<WfExecute>()
                .eq(WfExecute::getOptype, "2")
                .last("LIMIT 5")
        );

        for (WfExecute execute : rejectExecutes) {
            WfInstanceDtl dtl = wfInstanceDtlMapper.selectById(execute.getInstdtlid());
            if (dtl != null) {
                WfInstance instance = wfInstanceMapper.selectById(dtl.getInstanceid());
                if (instance != null) {
                    assertEquals("2", instance.getStatus(),
                        "不同意操作后，实例状态应该为'2'");
                }
            }
        }

        System.out.println("✓ 一致性3通过：不同意操作状态一致");
    }
}
