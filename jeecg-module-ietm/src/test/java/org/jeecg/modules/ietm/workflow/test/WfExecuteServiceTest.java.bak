    @DisplayName("场景5.1：追加意见 - 正常追加")
    public void testAddOpinion() {
        if (testDtlId == null) {
            System.out.println("跳过测试：无可用测试数据");
            return;
        }

        WfExecute execute = new WfExecute();
        execute.setInstdtlid(testDtlId);
        execute.setIfpass("5"); // 追加意见
